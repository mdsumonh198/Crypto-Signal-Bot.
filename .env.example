# Copy to .env. Environment variables override this file. Booleans: true/false.
PAIRS=BTC-USD,ETH-USD
# 0 uses PAIRS; >0 discovers and ranks active Coinbase USD markets by turnover.
TOP_MARKETS=250
TIMEFRAME=900
# Check every minute; analyze only when a new completed candle is available.
SCAN_INTERVAL=60
HISTORY=300
MIN_VOLUME_USD=1000000
MAX_SPREAD_BPS=20
MIN_ATR_PCT=0.05
MAX_ATR_PCT=5
BUY_SCORE=75
WATCH_SCORE=60
RSI_LOW=52
RSI_HIGH=68
VOLUME_BUY_RATIO=1.05
BTC_BREAKDOWN_PCT=-3
BTC_BEARISH_PCT=-1
STOP_ATR=2
REWARD_RISK=2
MAX_STOP_PCT=10
COOLDOWN=3600
SCORE_IMPROVEMENT=5
WATCH_ALERTS=false
WATCH_TO_BUY=true
# Credentials used only with scan --notify. Do not commit .env.
TELEGRAM_TOKEN=8424519896:AAEP5jZb-I-BV6UKOK9n4zwGhvRwXPwTgJ4
TELEGRAM_CHAT_ID=-1003469042236
PAPER=false
PAPER_EQUITY=10000
RISK_PER_TRADE=0.01
MAX_EXPOSURE=0.3
MAX_POSITIONS=5
DAILY_LOSS_LIMIT=0.03
FEE_BPS=60
SLIPPAGE_BPS=5
DATABASE=data/scanner.sqlite
